# =============================================================================
# FAST CHICKN — variáveis de ambiente
# Copie para .env.local e preencha. NUNCA versione o .env.local.
# =============================================================================

# --- Públicas (expostas ao navegador; protegidas por RLS) --------------------
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Coordenadas padrão usadas para estimar distância quando o endereço do
# cliente não possui localização (centro de São Paulo).
NEXT_PUBLIC_DEFAULT_LAT=-23.5505
NEXT_PUBLIC_DEFAULT_LNG=-46.6333

# (Opcional) Logo oficial — ex.: /brand/logo.svg dentro de /public.
# Vazio = logo textual temporária FAST CHICKN.
NEXT_PUBLIC_BRAND_LOGO_URL=

# --- Privadas (somente servidor / scripts) ----------------------------------
# Usada APENAS pelo script de seed (npm run db:seed). Nunca use no frontend
# e nunca configure com prefixo NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# Senha aplicada às contas de demonstração criadas pelo seed.
SEED_DEMO_PASSWORD=troque-esta-senha

# --- Integração futura: gateway de pagamento PIX ----------------------------
# Deixe vazio para usar o ambiente de demonstração (sem cobrança real).
PAYMENT_PROVIDER=demo
PAYMENT_GATEWAY_API_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Integração futura: Web Push -------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
